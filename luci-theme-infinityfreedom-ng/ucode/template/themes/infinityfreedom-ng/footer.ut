        <!-- end Footer -->

    </div> <!-- content-page -->
</div> <!-- END wrapper -->

<script>
	/* run the bootstrap-ification once the client side view is in place.
	   - for legacy pages (server rendered template actions) the DOM is
	     already there when this script executes
	   - for modern client rendered views #view is filled asynchronously;
	     wait for it to settle, then render ONCE (renderPage() is not
	     idempotent - re-running would nest the card wrappers) */
	(function() {
		/* full-template app pages (e.g. passwall2) render their CBI
		   markup straight into the page with no #view container - fall
		   back to the .cbi-map root so the bootstrap-ification runs */
		let viewEl = document.getElementById('view') || document.querySelector('.cbi-map');

		if (!viewEl || typeof(renderPage) == "undefined")
			return;

		/* declared before ngFullRender() so the synchronous path below
		   cannot hit the temporal dead zone of a later `let` binding */
		var obs = null;
		let ngDone = false;

		function ngFullRender() {
			if (ngDone)
				return;
			ngDone = true;
			obs?.disconnect();

			let t = (typeof(luciLocation) != "undefined")
				&& luciLocation.length == 3
				&& luciLocation[1] == "status"
				&& luciLocation[2] == "overview";

			/* modern client rendered views use <div class="cbi-section">
			   where legacy server rendered CBI used <fieldset> - apply the
			   same card treatment before the legacy renderer runs */
			function wrapSections() {
				/* tabbed maps (network/network) render one section per tab
				   panel as direct children of .cbi-map-tabbed, with the
				   tab menu as the group's preceding sibling - ui.tabs
				   switchTab() resolves panels via menu.nextElementSibling
				   and group.childNodes[data-tab], so panels must stay
				   direct children: wrap the WHOLE group (menu + panels)
				   as a single card instead */
				jQuery(".cbi-map-tabbed").each(function(i, e) {
					let mt = jQuery(e);
					if (mt.closest('.card').length > 0)
						return;
					let menu = mt.prev('ul.cbi-tabmenu');
					let target = (menu.length > 0 ? menu : jQuery()).add(mt);
					target.wrapAll('<div class="card"></div>').wrapAll('<div class="col-12"></div>');
					mt.children('.cbi-section').addClass('card-body');
				});

				jQuery("div.cbi-section:not(fieldset)").each(function(i, e) {
					let el = jQuery(e);
					/* already wrapped, or a nested section inside a tab
					   panel (1.2 keeps those inside the tab content area,
					   not as separate cards) */
					if (el.closest('.card').length > 0 || el.hasClass('cbi-section-node'))
						return;
					if (el.closest('.cbi-tabcontainer').length > 0)
						return;
					if (el.closest('.cbi-map-tabbed').length > 0)
						return;
					let col = jQuery('<div class="col-12"></div>');
					let card = jQuery('<div class="card"></div>');
					el.wrap(col);
					el.wrap(card);
					el.addClass('card-body');
				});
			}

			/* "bare" modern views (crontab, processes, startup, ...) have
			   no cbi-section markup at all - wrap their main content in a
			   card so they get the same look the legacy server rendered
			   CBI pages had */
			function wrapBareView() {
				/* anything already cardified (incl. our own col-12/card
				   wrappers - matching them here again would nest a new
				   card layer on every poll and grow the DOM forever) */
				if (viewEl.querySelector('.cbi-section, .cbi-map .card') != null
				    || viewEl.firstElementChild?.classList.contains('col-12'))
					return;

				/* Bare views may use ui.tabs directly (status/iptables):
				   #view contains a generated ul.cbi-tabmenu immediately followed
				   by one plain div whose direct children are [data-tab] panes.
				   ui.tabs.switchTab() resolves panes strictly through
				   menu.nextElementSibling.childNodes. Wrapping menu and group as
				   separate cards breaks that contract: the tab highlight changes
				   but data-tab-active/content never does. Keep both as adjacent
				   siblings inside one shared card-body. */
				jQuery(viewEl).children('ul.cbi-tabmenu').each(function(i, e) {
					let menu = jQuery(e);
					let group = menu.next();
					if (group.length == 0 || group.children('[data-tab]').length == 0)
						return;
					let target = menu.add(group);
					target.wrapAll('<div class="card-body"></div>');
					let body = menu.parent();
					body.wrap('<div class="card"></div>');
					body.parent().wrap('<div class="col-12"></div>');
				});

				let main = jQuery(viewEl).children().filter(function(i, e) {
					return !e.matches('h2, .cbi-map-descr, .cbi-section-descr, .cbi-page-actions, script, .spinning, .col-12');
				});

				main.each(function(i, e) {
					let el = jQuery(e);
					if (el.closest('.card').length > 0)
						return;
					el.wrap('<div class="col-12"></div>');
					el.wrap('<div class="card"></div>');
					el.addClass('card-body');

					/* renderPage only wraps table.cbi-section-table in
					   .table-responsive - plain view tables need it too */
					el.find('table').addBack('table').each(function(j, tb) {
						if (jQuery(tb).closest('.table-responsive').length == 0)
							jQuery(tb).wrap('<div class="table-responsive"></div>');
					});
				});
			}
			jQuery("div.cbi-section > h3, div.cbi-section > h4").addClass('header-title mb-3');
			jQuery("div.cbi-map > .cbi-section > h3:first-child").css('font-size', 'large');

			wrapSections();
			wrapBareView();
			styleModernButtons();
			styleModernFormControls();
			/* renderPage already ran at ngRender.js parse time over the
			   full server DOM (no #view on full-template pages like
			   passwall2 - that call wrapped the fieldsets, styled the
			   inputs and the page actions). Calling it again here would
			   nest the card wrappers; on #view pages the parse-time call
			   was a no-op over the empty view, so this delayed call is
			   the one that does the real work. */
			if (viewEl.id == 'view')
				renderPage(t);
			styleTabmenus(viewEl);

			/* poll-driven views (e.g. dockerman/containers) rebuild their
			   cbi-sections every few seconds, discarding our wrappers -
			   re-wrap new bare sections and re-hide the rebuilt h2 after
			   every mutation.

			   Throttled: views that insert large lists row by row
			   (package-manager: thousands of <tr>) fire hundreds of
			   mutations per second; an unthrottled full-DOM rescan on
			   each one starves the main thread. Coalesce bursts into a
			   single rescan at most every 250ms, and only schedule a new
			   check while one is pending (no timer, so background-tab
			   throttling merely delays, never deadlocks). */
			let restylePending = false;
			let restyleLast = 0;

			function styleTabmenus(root) {
				root = root || document;

				/* cbi_init() builds ul.cbi-tabmenu via jQuery(document).ready,
				   i.e. AFTER this script parsed and legacy renderPage() ran -
				   bootstrap-ify tab bars here (idempotent: addClass on an
				   already-styled bar is a no-op) */
				jQuery(root).find("ul.cbi-tabmenu:not(.nav)").each(function(i, e) {
					let ul = jQuery(e);
					ul.addClass("nav nav-tabs nav-bordered");

					let next = ul.next();
					if (next.is("fieldset") || next.hasClass("cbi-section-node") || next.hasClass("cbi-section-node-tabbed"))
						ul.addClass("mb-3");

					ul.children("li").each(function(j, li) {
						let l = jQuery(li);
						l.addClass("nav-item");
						let a = l.find("a");
						if (l.hasClass("cbi-tab-disabled"))
							a.addClass("nav-link");
						else
							a.addClass("nav-link active");
					});
				});

				/* keep bootstrap active state in sync when cbi tabs are
				   switched (cbi.js toggles cbi-tab classes; delegate so it
				   survives any re-render) */
				if (!root.__ngTabsDelegated) {
					root.__ngTabsDelegated = true;
					jQuery(root).on("click", "ul.nav-tabs > li.nav-item", function(ev) {
						let ul = jQuery(this).closest("ul.nav-tabs");
						ul.find("li.nav-item > a").removeClass("active");
						jQuery(this).find("a").addClass("active");
					});
				}
			}

			/* modern client views render <button> elements instead of the
			   legacy <input type=submit> - the legacy renderButtons() only
			   matches input.cbi-button-* so these get no theme classes at
			   all (browser-default white buttons).

			   LuCI 24.10 ui.js adds a bare .btn (transparent background)
			   to view buttons, and form.js adds semantic classes it does
			   not style itself: positive / negative / neutral / action.
			   Map them onto the theme's bootstrap button variants - same
			   colors the legacy inputs got via renderButtons(). */
			function styleModernButtons(root) {
				root = root || viewEl;
				let map = {
					'cbi-button-apply':  'btn btn-primary waves-effect waves-light',
					'cbi-button-save':   'btn btn-info waves-effect waves-light',
					'cbi-button-reset':  'btn btn-warning waves-effect waves-light',
					'cbi-button-add':    'btn btn-success waves-effect waves-light',
					'cbi-button-edit':   'btn btn-info waves-effect waves-light',
					'cbi-button-remove': 'btn btn-danger waves-effect waves-light',
					'cbi-button-reload': 'btn btn-purple waves-effect waves-light',
					/* new in LuCI >= 22.03 client-side views */
					'cbi-button-positive': 'btn btn-success waves-effect waves-light',
					'cbi-button-negative': 'btn btn-danger waves-effect waves-light',
					'cbi-button-neutral':  'btn btn-secondary waves-effect waves-light',
					'cbi-button-action':   'btn btn-purple waves-effect waves-light'
				};

				jQuery(root).find('button.cbi-button, button[class*="cbi-button-"]').each(function(i, e) {
					let el = jQuery(e);
					for (let cls in map) {
						if (el.hasClass(cls)) {
							el.addClass(map[cls]);
							break;
						}
					}
				});

				/* form.js maps apply/save/reset onto plain .cbi-button
				   without any semantic suffix */
				jQuery(root).find('button.cbi-button:not([class*="cbi-button-"])').addClass('btn btn-purple waves-effect waves-light');
			}

			/* form.js renders its widgets after ngRender.js parsed, so
			   ngRenderFormControls() (bootstrap classes for selects,
			   text inputs) never sees them - re-apply here. Also covers
			   the checkboxes form.js emits without any class (legacy
			   server markup had cbi-input-checkbox) and the LuCI
			   dropdown widgets (div.cbi-dropdown) which need a dark
			   variant to be visible. Idempotent by class checks.
			   Called with #modal_overlay as root by the dialog watcher
			   below - dialogs build their DOM after ngRender ran. */
			function styleModernFormControls(root) {
				root = root || viewEl;

				jQuery(root).find('select.cbi-input-select:not(.form-select), select:not([class])').addClass('form-select');
				jQuery(root).find('input.cbi-input-text:not(.form-control), input[type=text]:not(.form-control):not(.create-item-input)').addClass('form-control');
				jQuery(root).find('input.cbi-input-password:not(.form-control)').addClass('form-control');
				jQuery(root).find('textarea:not(.form-control)').addClass('form-control');
				jQuery(root).find('input[type=checkbox]:not(.form-check-input):not([class])').addClass('form-check-input');

				/* modern form.js toggles use <input type=checkbox> inside
				   .cbi-value-field without the legacy cbi-input-checkbox
				   class - give them the checkbox look too */
				jQuery(root).find('.cbi-value-field > input[type=checkbox]:not(.form-check-input)').addClass('form-check-input');
			}

			function restylePollRefreshed() {
				wrapSections();
				wrapBareView();
				styleTabmenus(viewEl);
				styleModernButtons();
				styleModernFormControls();
				jQuery("h2[name=content]").css('display', 'none');
				jQuery("div.cbi-section > h3, div.cbi-section > h4").addClass('header-title mb-3');
			}

			function restyleScheduled() {
				restylePending = false;
				restyleLast = Date.now();
				restylePollRefreshed();
			}

			function scheduleRestyle() {
				if (restylePending)
					return;

				let since = Date.now() - restyleLast;
				if (since >= 250) {
					restylePending = true;
					Promise.resolve().then(restyleScheduled);
				} else {
					restylePending = true;
					setTimeout(restyleScheduled, 250 - since);
				}
			}

			/* keep observing after the initial render: passwall2-style
			   full-template pages have cbi_init() build their tab bars
			   via jQuery(document).ready, i.e. after this script ran.
			   obs is still null on the synchronous path (the assignment
			   at the bottom never runs there) - hence the ?. */
			obs?.disconnect();
			obs = new MutationObserver(function() {
				scheduleRestyle();
			});
			obs.observe(viewEl, { childList: true, subtree: true });

			/* LuCI renders dialogs (ui.showModal) into #modal_overlay at
			   body level, outside #view. ui.js creates that node during
			   setupDOM (after this script runs), so: watch body for its
			   creation, then watch the overlay itself for dialog content
			   and style those buttons too */
			function watchModalOverlay(ov) {
				if (ov.__ngWatched)
					return;
				ov.__ngWatched = true;
				new MutationObserver(function() {
					styleModernButtons(ov);
					styleModernFormControls(ov);
				}).observe(ov, { childList: true, subtree: true });
			}

			let modalObserver = new MutationObserver(function() {
				document.querySelectorAll('#modal_overlay').forEach(watchModalOverlay);
			});
			modalObserver.observe(document.body, { childList: true, subtree: false });
			document.querySelectorAll('#modal_overlay').forEach(watchModalOverlay);

			/* legacy ngRender.js moves title/descr at load time which is
			   too early for async views - redo it here */
			let titleEle = jQuery("h2[name=content]");
			/* modern client rendered views (LuCI >= 22.03 ucode views)
			   emit <h2> without the legacy name="content" attribute -
			   treat the first heading inside #view the same way */
			if (titleEle.length == 0)
				titleEle = jQuery(viewEl).find("h2").first();

			if (titleEle.length > 0) {
				jQuery("#homelede_page_title").html(titleEle[0].innerHTML);
				jQuery("#homelede_page_desc_popup > div.toast-header > strong.me-auto").html(titleEle[0].innerHTML);
				titleEle[0].style.display = "none";
			}

			let descr = jQuery("div.cbi-map-descr");
			if (descr.length > 0) {
				let d = jQuery(descr[0]);
				jQuery("#homelede_page_desc").html(d.html()).attr("title", "点击放大页面描述。");
				jQuery("#homelede_page_desc_popup > div.toast-body").html(d.html());
				d.css("display", "none");
			}
		}

		/* view.ut always renders a spinning "Loading view…" placeholder
		   inside #view, so "has children" is not "has content".
		   Note: poll-driven widgets keep their own <em class="spinning">
		   "collecting data" placeholders forever between polls, so we
		   must not require the absence of ALL spinners - only look for
		   actual view content markers instead. */
		function hasRealContent() {
			let v = viewEl;
			if (!v || v.children.length == 0)
				return false;
			/* still the initial placeholder? */
			if (v.children.length == 1 && v.firstElementChild.classList.contains('spinning'))
				return false;
			/* real view content markers (modern client views + legacy CBI) */
			return !!(v.querySelector('.cbi-map, .cbi-section, .ifacebox, table, form, h2, ul, ol'));
		}

		/* synchronous (legacy server rendered) pages: DOM is ready now */
		if (hasRealContent()) {
			ngFullRender();
			return;
		}

		/* async client rendered views: fires once L.setupDOM finished */
		function ngMaybe() {
			if (hasRealContent())
				ngFullRender();
		}

		if (typeof(L) != "undefined" && L.env && !L.loaded)
			document.addEventListener('luci-loaded', ngMaybe, { once: true });

		/* belt and braces: watch #view mutations. View.render() fills #view
		   in a single DOM.content() replacement, so a content marker seen
		   in the (microtask) mutation callback means the full tree is in.
		   No setTimeout debounce here: background tabs throttle timers to
		   ~1/minute which would delay rendering until refocus. */
		obs = new MutationObserver(function() {
			ngMaybe();
		});

		obs.observe(viewEl, { childList: true, subtree: true });
	})();
</script>

<!-- Right bar overlay-->
<div class="rightbar-overlay"></div>
<script>
jQuery(function()
{
	if(jQuery("body").hasClass("authentication-bg")){
		jQuery("footer.footer").addClass("footer-login")
		jQuery("div.content-page").addClass("content-page-login")
	}
})
</script>
<script src="{{ media }}/assets/js/thirdLevelMenuApp.js"></script>
<script>
	jQuery(function(){
		if(typeof(animation)!="undefined"){
			animation.destroy();
		}
		jQuery("#loading_cover").hide()
	})
</script>
</body>

