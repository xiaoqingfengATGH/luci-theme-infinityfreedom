{% include("themes/" + theme + "/header_login") %}
			<div class="account-pages mt-5 mb-5">
				<div class="container">
					<div class="row justify-content-center">
						<div class="col-md-8 col-lg-6 col-xl-4">
							<div class="card shadow-none">
								{% if (fuser): %}
								<div class="alert alert-warning bg-warning text-white border-0 alert-dismissible fade show" role="alert">
									<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
									{{ _('Invalid username and/or password! Please try again.') }}
								</div>
								{% endif %}
								<div class="card-body p-3">

									<div class="text-center w-75 m-auto">
										<div class="auth-logo">
											<a href="{{ dispatcher.build_url() }}" class="logo logo-dark text-center">
												<span class="logo-lg">
													<img src="{{ media }}/assets/images/Homelede2023-logo-light.png" alt="" height="44">
												</span>
											</a>

											<a href="{{ dispatcher.build_url() }}" class="logo logo-light text-center">
												<span class="logo-lg">
													<img src="{{ media }}/assets/images/Homelede2023-logo-light.png" alt="" height="44">
												</span>
											</a>
										</div>
										<p class="text-muted mb-4 mt-3">{{ _('请输入用户名密码登录到您的路由器') }}</p>
									</div>

									<form action="{{ entityencode(http.getenv('REQUEST_URI'), true) }}">

										<div class="mb-3">
											<label for="luci_username" class="form-label">{{ _('Username') }}</label>
											<input class="form-control form-control-login" required="true" placeholder="Enter your username" type="text" name="luci_username" value="{{ entityencode(duser, true) }}">
										</div>

										<div class="mb-3">
											<label for="password" class="form-label">{{ _('Password') }}</label>
											<div class="input-group input-group-merge">
												<input type="password" id="password" class="form-control" placeholder="Enter your password" name="luci_password">
												<div class="input-group-text" data-password="false">
													<span class="password-eye"></span>
												</div>
											</div>
										</div>

										<div class="text-center d-grid button-list">
											<button class="btn btn-primary" type="submit"> {{ _('Login') }} </button>
											<button class="btn btn-light waves-effect" type="reset"> {{ _('Reset') }} </button>
										</div>

									</form>

								</div> <!-- end card-body -->
							</div>
							<!-- end card -->
							<!-- end row -->

						</div> <!-- end col -->
					</div>
					<!-- end row -->
				</div>
				<!-- end container -->
			</div>
			<!-- end page -->
			{%
				let https_key = uci.get('uhttpd', 'main', 'key');
				let https_port = uci.get('uhttpd', 'main', 'listen_https') ?? [];
				https_port = (type(https_port) == 'string') ? split(https_port, /\s+/) : https_port;
				https_port = filter(https_port, p => p != null);

				if (length(https_port) && https_key && match(https_key, /\.pem$|\.key$/) != null) {
					https_port = https_port[0];
			%}
			<script type="text/javascript">//<![CDATA[
				if (document.location.protocol != 'https:') {
					var url = 'https://' + window.location.hostname + ':' + '{{ https_port }}' + window.location.pathname;
					var img = new Image;
					img.onload = function () { window.location = url };
					img.src = 'https://' + window.location.hostname + ':' + '{{ https_port }}' + '{{ resource }}/cbi/up.gif?' + Math.random();;
					setTimeout(function () {
						img.src = ''
					}, 5000);
				}
			//]]></script>
			{% } %}
{% include("themes/" + theme + "/footer_login") %}
