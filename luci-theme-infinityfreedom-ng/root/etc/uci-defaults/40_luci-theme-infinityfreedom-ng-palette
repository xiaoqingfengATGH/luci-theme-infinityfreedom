#!/bin/sh

# palette (color scheme) section for the theme; values: default | blackgold | canyon | luminousblue
uci -q get infinityfreedom-ng.palette >/dev/null 2>&1 || uci -q batch <<-EOF
	set infinityfreedom-ng.palette=theme
	set infinityfreedom-ng.palette.name='default'
	commit infinityfreedom-ng
EOF

exit 0
