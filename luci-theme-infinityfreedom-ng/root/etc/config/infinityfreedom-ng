# ---- new groups + moves (uncomment and edit as needed) ----
#
# 1) declare a new group, icon required (classes from icons.min.css,
#    e.g. fe-layers / fe-box / fe-grid / fe-folder / fe-briefcase,
#    dripicons-* and mdi mdi-* families are available too):
#
# config menugroup
# 	option path 'admin/mygroup'
# 	option title '我的分组'
# 	option icon 'fe-layers'
#
# 2) move existing entries into it (order optional, larger = later;
#    unlisted moved entries sort after the group's real children).
#    A moved entry keeps its URL and page behavior, only its sidebar
#    position changes. An icon may be given per moved entry too.
#
# config menumove
# 	option path 'admin/services/ddns-go'
# 	option target 'admin/mygroup'
# 	option order '10'
#
# config menumove
# 	option path 'admin/services/homeredirect'
# 	option target 'admin/mygroup'
# 	option order '20'
#
# 3) an existing group can also be given a different icon:
#
# config menugroup
# 	option path 'admin/services'
# 	option icon 'fe-box'
