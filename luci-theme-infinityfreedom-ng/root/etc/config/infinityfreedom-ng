# Menu customization for the InfinityFreedom-NG theme.
#
# Four section types control the sidebar rendered by header.ut:
#
#   config menuorder   - reorder children of a menu node
#   config menurename  - rename a menu node (display title only)
#   config menugroup   - declare a new top level group, or restyle an
#                        existing one (icon only)
#   config menumove    - move a node into another group, keeping its URL
#
# Node paths follow the menu URL after /cgi-bin/luci/, e.g.
#   /cgi-bin/luci/admin/services/ddns-go  ->  path 'admin/services/ddns-go'
# Level-1 sidebar entries are children of 'admin', so reorder them with
# path 'admin'. Node names are the last path segment.
#
# Listed children sort by list position; unlisted ones keep their default
# order and follow after the listed ones. All groups below are fully
# enumerated in their current (factory) order, so this file renders
# exactly like an uncustomized menu - just reorder lines at will.
#
# Notes:
# - Uninstalled apps drop out of the menu automatically; entries left
#   here for missing nodes are harmless no-ops.
# - New apps installed later (not listed here) append to the end of
#   their group; add them to a list to pin their position.
# - menurename overrides only the display title; icons/tab highlighting
#   match on the original (data-title) text and stay unaffected.
# - menumove targets must render as a group: the top level ('admin'),
#   an existing group (e.g. 'admin/services'), or a path declared by a
#   menugroup section. Moves into leaf pages are ignored (the entry
#   would vanish from the two level sidebar).

# ---- level 1 (children of 'admin') ----

config menuorder
	option path 'admin'
	list order 'status'      # 状态
	list order 'network'     # 网络
	list order 'vpn'         # VPN
	list order 'services'    # 服务
	list order 'nas'         # 网络存储
	list order 'control'     # 管控
	list order 'system'      # 系统

# ---- 状态 (admin/status) ----

config menuorder
	option path 'admin/status'
	list order 'overview'      # 驾驶舱
	list order 'routesj'       # 路由
	list order 'nftables'      # 防火墙
	list order 'processes'     # 进程
	list order 'realtime'      # 实时信息
	list order 'release_ram'   # 释放内存
	list order 'mwan3'         # MultiWAN 管理器
	list order 'logs'          # 系统日志

config menurename
 	option path 'admin/status/mwan3'
 	option title '多WAN状态'

# ---- 系统 (admin/system) ----

config menuorder
	option path 'admin/system'
	list order 'system'          # 系统
	list order 'admin'           # 管理权
	list order 'diskman'         # 磁盘管理
	list order 'mounts'          # 挂载点
	list order 'ttyd'            # 终端
	list order 'homestatus'      # 定制驾驶舱
	list order 'package-manager' # 软件包
	list order 'filetransfer'    # 文件传输
	list order 'startup'         # 启动项
	list order 'crontab'         # 计划任务
	list order 'flash'           # 备份与更新
	list order 'autoreboot'      # 定时重启
	list order 'reboot'          # 重启

config menurename
 	option path 'admin/system'
 	option title '系统设置'

config menurename
 	option path 'admin/system/system'
 	option title '基础信息'

config menurename
 	option path 'admin/system/admin'
 	option title '密码及远程访问'

config menurename
 	option path 'admin/system/mounts'
 	option title '挂载磁盘'

# ---- 服务 (admin/services) ----

config menuorder
	option path 'admin/services'
#	list order 'passwall2'     # PassWall 2
	list order 'acme'          # ACME 证书
	list order 'homeredirect'  # 端口转发
	list order 'nlbw'          # 带宽监控
	list order 'hometunnel'    # HomeTunnel
	list order 'wol'           # 网络唤醒
	list order 'ddns-go'       # DDNS-Go
	list order 'dockerman'     # Dockerman JS
#	list order 'ksmbd'         # 网络共享
	list order 'upnp'          # UPnP IGD 和 PCP
	list order 'vlmcsd'        # Vlmcsd KMS 服务器

# ---- 管控 (admin/control) ----

config menuorder
	option path 'admin/control'
	list order 'webrestriction'  # 访问限制
	list order 'weburl'          # 网址过滤
	list order 'timewol'         # 定时唤醒

# ---- 网络存储 (admin/nas) ----

config menuorder
	option path 'admin/nas'
	list order 'cifs-mount'   # 挂载 SMB 网络共享
	list order 'ksmbd'         # 网络共享
	list order 'hd_idle'      # 硬盘休眠
	list order 'vsftpd'       # FTP 服务器

config menurename
 	option path 'admin/nas/cifs-mount'
 	option title '挂载SMB存储到路由'

config menumove
 	option path 'admin/services/ksmbd'
 	option target 'admin/nas'

config menurename
 	option path 'admin/nas/ksmbd'
 	option title '共享路由存储到内网'

# ---- VPN (admin/vpn) ----

config menuorder
	option path 'admin/vpn'
	list order 'passwall2'     # PassWall 2
	list order 'ipsec-server'  # IPSec VPN 服务器

config menumove
 	option path 'admin/services/passwall2'
 	option target 'admin/vpn'

# ---- 网络 (admin/network) ----

config menuorder
	option path 'admin/network'
	list order 'network'       # 接口
	list order 'routes'        # 路由
	list order 'dhcp'          # DHCP
	list order 'arpbind'       # IP/MAC绑定
	list order 'dns'           # DNS
	list order 'diagnostics'   # 网络诊断
	list order 'firewall'      # 防火墙
	list order 'syncdial'      # 多线多拨
	list order 'mwan3'         # MultiWAN 管理器
	list order 'turboacc'      # Turbo ACC 网络加速

config menurename
 	option path 'admin/network/mwan3'
 	option title '多WAN管理器'

